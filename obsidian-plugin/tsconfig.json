{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "../lib/explorer-model.ts",
    "../lib/drag-geometry.ts",
    "../lib/drag-hit-test.ts"
  ]
}
